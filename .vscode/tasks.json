{
    "tasks": [
        // -------------------------------------------------------------------
        {
            "type": "shell",
            "label": "Precompile folder UTILS",
            "command": "mkdir -p build && g++ -std=c++17 -g -c utils/satencoder.cpp utils/zielonka.cpp utils/tarjan.cpp utils/game.cpp utils/fra.cpp -I${env:HOME}/.local/include && mv *.o build/",
            "group": "build",
            "presentation": {
                "reveal": "always"
            }
        },
        // -------------------------------------------------------------------
        {
            "type": "cppbuild",
            "label": "Build Experiment 5",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "-fdiagnostics-color=always",
                "-g",
                // "-pg",

                // -- using precompiled util's files
                "${workspaceFolder}/build/satencoder.o",
                "${workspaceFolder}/build/zielonka.o",
                "${workspaceFolder}/build/tarjan.o",
                "${workspaceFolder}/build/game.o",
                "${workspaceFolder}/build/fra.o",

                // "${workspaceFolder}/utils/satencoder.cpp",
                // "${workspaceFolder}/utils/zielonka.cpp",
                // "${workspaceFolder}/utils/tarjan.cpp",
                // "${workspaceFolder}/utils/game.cpp",
                // "${workspaceFolder}/utils/fra.cpp",

                "${workspaceFolder}/experiments/ex5.cpp",
                "-o",
                "${workspaceFolder}/build/nocq",

                "-I${env:HOME}/.local/include",
                "-L${env:HOME}/.local/lib",
                "-lchuffed_fzn",
                "-lchuffed",
                "${env:HOME}/.local/lib/libchuffed_fzn.a",
                "${env:HOME}/.local/lib/libchuffed.a",

                // "-I${workspaceFolder}/thirdparty/chuffed",
                // "-L${workspaceFolder}/thirdparty/chuffed/build",
                // "-lchuffed_fzn",
                // "-lchuffed",
                // "-I${workspaceFolder}/thirdparty/cadical/src",
                // "-L${workspaceFolder}/thirdparty/cadical/build",
                // "-lcadical",
                // "${workspaceFolder}/thirdparty/chuffed/build/libchuffed_fzn.a",
                // "${workspaceFolder}/thirdparty/chuffed/build/libchuffed.a",

                // "-DHAS_GECODE",
                // "-lpthread",
                // "-lgecodesearch",
                // "-lgecodeint",
                // "-lgecodekernel",
                // "-lgecodesupport",

                // "-DHAS_CADICAL",
                // "-lcadical",
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        },      
        // -------------------------------------------------------------------
        {
            "type": "cppbuild",
            "label": "Build FRA",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "-fdiagnostics-color=always",
                "-g",
                "-O0",
                "${workspaceFolder}/chuffed-patch/game.cpp",
                "${workspaceFolder}/various/fra.cpp",
                "${workspaceFolder}/various/graph.cpp",
                "${workspaceFolder}/various/tarjan.cpp",
                "${workspaceFolder}/experiments/ex2.cpp",
                // "${workspaceFolder}/cp_fra/coattractorbranching.cpp",
                "-o",
                "${workspaceFolder}/build/ex2",
                "-I${env:HOME}/.local/include",
                "-L${env:HOME}/.local/lib",
                "-lchuffed",
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        },
        // -------------------------------------------------------------------
        {
            "type": "cppbuild",
            "label": "Build standard C/C++",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++14",
                "-fdiagnostics-color=always",
                "-g",
                "-O0",
                "-DNDEBUG",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}",
                "-I${env:HOME}/.local/include",
                "-L${env:HOME}/.local/lib",
                "-lchuffed"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        },
    ],
    "version": "2.0.0"
}