        {
            "type": "cppbuild",
            "label": "C/C++: build standard",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++14",
                "-fdiagnostics-color=always",
                "-g",
                "-O0",
                "-DNDEBUG",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}",
                "-I${env:HOME}/.local/include",
                "-L${env:HOME}/.local/lib",
                "-lchuffed"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
