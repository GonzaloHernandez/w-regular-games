From: Gonzalo Hernandez <gonzalohernandez@udenar.edu.co>
Date: Fri, 27 Feb 2026 12:06:49 +1100
Subject: [PATCH] Add noc.h support and update registry for w-regular games

---
 chuffed/flatzinc/registry.cpp |  29 +++++++
 chuffed/support/noc.h         | 151 ++++++++++++++++++++++++++++++++++
 2 files changed, 180 insertions(+)
 create mode 100644 chuffed/support/noc.h

diff --git a/chuffed/flatzinc/registry.cpp b/chuffed/flatzinc/registry.cpp
index c17c274..8816ebd 100644
--- a/chuffed/flatzinc/registry.cpp
+++ b/chuffed/flatzinc/registry.cpp
@@ -1834,6 +1834,32 @@ void p_bounded_path_new(const ConExpr& ce, AST::Node* /*ann*/) {
 	bounded_path(s, t, vs, es, in, ou, en, ws, w);
 }
 
+// --- w-regular-games ---
+#include "chuffed/support/noc.h"
+
+void p_noc(const ConExpr& ce, AST::Node* ann) {
+	vec<int> owners;	arg2intargs(owners,ce[0]);
+	vec<int> priors;	arg2intargs(priors,ce[1]);
+	vec<int> sources;	arg2intargs(sources,ce[2]);
+	vec<int> targets;	arg2intargs(targets,ce[3]);
+	int init =			ce[4]->getInt();
+	int player =		ce[5]->getInt();
+	int reward =		ce[6]->getInt();
+	vec<BoolView> V;	arg2BoolVarArgs(V,ce[7]);
+	vec<BoolView> E;	arg2BoolVarArgs(E,ce[8]);
+
+	// --- Fixing zeros ---
+	for (int i=0; i<sources.size(); i++) {
+		sources[i]--;
+		targets[i]--;
+	}
+	init--;
+
+	// --- Publishing propagator ---
+	Game* g = new Game(owners,priors,sources,targets,init,(reward_type)reward);
+	new NoOpponentCycle(*g,V,E,(parity_type)player);
+}
+
 class IntPoster {
 public:
 	IntPoster() {
@@ -1986,6 +2012,9 @@ public:
 		registry().add("chuffed_dpath", &p_path_new);
 		registry().add("chuffed_dag", &p_dag_new);
 		registry().add("chuffed_bounded_dpath", &p_bounded_path_new);
+
+		// --- w-regular-games ---
+		registry().add("noc", &p_noc);
 	}
 };
 IntPoster _int_poster;
diff --git a/chuffed/support/noc.h b/chuffed/support/noc.h
new file mode 100644
index 0000000..910b8e6
--- /dev/null
+++ b/chuffed/support/noc.h
@@ -0,0 +1,151 @@
+enum parity_type    {EVEN,ODD};                             // 0,1
+enum reward_type    {MIN,MAX};                              // 0,1
+enum game_type      {DEF,JURD,RAND,MLADDER,DZN,GM,GMW,DIM}; // 0,1,2,3,4,5,6
+
+//=============================================================================
+
+parity_type opponent(parity_type PARITY) {
+    if (PARITY==EVEN) return ODD; return EVEN;
+}
+
+//=============================================================================
+
+class Game {
+private:
+    vec<int>        owners,priors,sources,targets;
+    vec<vec<int>>   outs,ins;
+    int             nvertices,nedges,init;
+    reward_type     reward;
+
+public:
+    friend class NoOpponentCycle;
+    //-------------------------------------------------------------------------
+
+    Game(   vec<int>& _owners, vec<int>& _priors,
+            vec<int>& _sources, vec<int>& _targets,
+            int _init = 0, reward_type _reward = MAX)
+    : init(_init), reward(_reward)
+    {
+        _owners .moveTo(owners);
+        _priors .moveTo(priors);
+        _sources.moveTo(sources);
+        _targets.moveTo(targets);
+
+        nvertices = owners.size();
+        nedges    = sources.size();
+
+        outs.growTo(nvertices);
+        ins .growTo(nvertices);
+
+        for(int i = 0; i < nedges; i++) {
+            outs[sources[i]].push(i);
+            ins [targets[i]].push(i);
+        }
+    }
+
+    //-------------------------------------------------------------------------
+
+    bool comparePriorities(int p1,int p2) {
+        if (reward==MIN && p1 < p2) return true; 
+        if (reward==MAX && p1 > p2) return true;
+        return false;
+    }
+
+};
+
+//=============================================================================
+
+class NoOpponentCycle : public Propagator {
+private:
+    Game& g;
+    vec<BoolView> V;
+    vec<BoolView> E;
+    parity_type playerSAT;
+
+    const int   CF_DONE     = 1;
+    const int   CF_CONFLICT = 2;
+
+public:
+    //-------------------------------------------------------------------------
+    NoOpponentCycle(Game& _g, vec<BoolView>& _V, vec<BoolView>& _E, 
+        parity_type _playerSAT)
+    : g(_g), V(_V), E(_E), playerSAT(_playerSAT)
+    {
+        for (int i=0; i<g.nvertices;i++) V[i].attach(this, 1 , EVENT_F );
+        for (int i=0; i<g.nedges;   i++) E[i].attach(this, 1 , EVENT_F );
+    }
+    //-------------------------------------------------------------------------
+    int findVertex(int vertex,vec<int>& path) {
+        for (int i=0; i<path.size(); i++) {
+            if (path[i] == vertex) return i;
+        }
+        return -1;
+    }
+    //-------------------------------------------------------------------------
+    void clausify(vec<int>& path, vec<BoolView> &B, vec<Lit>& lits,int from) {
+        for (int i=from; i<path.size()-1; i++) {
+            lits.push(B[path[i]].getValLit());
+        }
+    }
+    //-------------------------------------------------------------------------
+    bool satisfy(vec<int>& pathV,vec<int>& pathE,int cycleIndex) {
+        int m = g.priors[pathV[cycleIndex]];
+        for (int i=cycleIndex+1; i<pathV.size(); i++) {
+            if (g.comparePriorities(g.priors[pathV[i]],m)) {
+                m = g.priors[pathV[i]];
+            }
+        }
+        return m%2==playerSAT;
+    };
+    //-------------------------------------------------------------------------
+    int filterEager(vec<int>& pathV, vec<int>& pathE, int v, 
+        int lastEdge, bool definedEdge) 
+    {
+        int index = findVertex(v,pathV);
+        if (index >= 0) {
+            if (!satisfy(pathV,pathE,index)) {
+                vec<Lit> lits;
+                lits.push();
+                clausify(pathE,E,lits,0);
+                Clause* reason = Reason_new(lits);
+                if (! E[lastEdge].setVal(false,reason)) {
+                    return CF_CONFLICT;
+                }
+            }
+        }
+        else if (definedEdge) {
+            pathV.push(v);
+            for (int i=0; i<g.outs[v].size(); i++) { int e = g.outs[v][i];
+                if (E[e].isFalse()) continue;
+
+                int w = g.targets[e];
+                pathE.push(e);
+                int status = filterEager(pathV, pathE, w, e, E[e].isTrue());
+                pathE.pop();
+                if (status == CF_CONFLICT) {
+                    return status;
+                }
+            }
+            pathV.pop();
+        }
+        return CF_DONE;
+    }
+    //-------------------------------------------------------------------------
+    bool propagate() override {
+        vec<int> pathV;
+        vec<int> pathE;
+
+        if (filterEager(pathV,pathE,g.init,-1,true) == CF_CONFLICT)
+            return false;
+
+        return true;
+    }
+    //-------------------------------------------------------------------------
+    void wakeup(int i, int) override {
+        pushInQueue();
+    }
+    //-------------------------------------------------------------------------
+    void clearPropState() override {
+        in_queue = false;
+    }
+};
